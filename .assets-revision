# Hugging Face dataset holding webharbor's heavy static assets
# (instance_seed/*.db, static/images/, static/external_cache/).
#
# fetch_assets.sh uses the `hf download` CLI. The pin below
# is a git revision (branch name like `main`, a tag, or a specific commit
# sha). Override at runtime with the ASSETS_REVISION env var.
#
# TEMPORARY: pinned to refs/pr/39 (the drugs_com.tar.gz PR discussion at
# https://huggingface.co/datasets/ChilleD/WebHarbor/discussions/39) because
# drugs_com's assets aren't on `main` yet. refs/pr/39 is a superset of
# `main` (all 16 existing tarballs, unchanged, plus drugs_com.tar.gz) so this
# is safe for every other site. Once PR 39 merges, re-pin to `main` (or the
# resulting merge commit SHA) and drop this note.
repo: ChilleD/WebHarbor
revision: refs/pr/39

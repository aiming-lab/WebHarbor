{"shortname": "codeblocks", "name": "Code::Blocks", "_id": "506c872771b75b111e821e3b", "url": "https://sourceforge.net/p/codeblocks/", "private": false, "short_description": "Code::Blocks is a free, open-source, cross-platform C, C++ and Fortran IDE built to meet the most demanding needs of its users. It is designed to be very extensible and fully configurable.\r\n\r\nFinally, an IDE with all the features you need, having a consistent look, feel and operation across platforms.\r\n\r\nBuilt around a plugin framework, Code::Blocks can be extended with plugins. Any kind of functionality can be added by installing/coding a plugin. For instance, compiling and debugging functionality is already provided by plugins!\r\n\r\nWe hope you enjoy using Code::Blocks!\r\n\r\nThe Code::Blocks Team", "creation_date": "2004-12-20", "summary": "A free C, C++ and Fortran IDE", "external_homepage": "https://codeblocks.sourceforge.io", "video_url": null, "socialnetworks": [{"accounturl": "", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "http://forums.codeblocks.org/", "developers": [{"username": "bluehazzard", "name": "bluehazzard", "url": "https://sourceforge.net/u/bluehazzard/"}, {"username": "jenslody", "name": "Jens Lody", "url": "https://sourceforge.net/u/jenslody/"}, {"username": "killerbot", "name": "Lieven de Cock", "url": "https://sourceforge.net/u/killerbot/"}, {"username": "thomas-denk", "name": "thomas", "url": "https://sourceforge.net/u/thomas-denk/"}, {"username": "christoj", "name": "Christo", "url": "https://sourceforge.net/u/christoj/"}, {"username": "wh11204", "name": "Miguel Gimenez", "url": "https://sourceforge.net/u/wh11204/"}, {"username": "mandrav", "name": "Yiannis Mandravellos", "url": "https://sourceforge.net/u/mandrav/"}, {"username": "mortenmacfly", "name": "Morten MacFly", "url": "https://sourceforge.net/u/mortenmacfly/"}, {"u
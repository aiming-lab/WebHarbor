{"shortname": "bandizip", "name": "Bandizip", "_id": "66ecdfa04d63823fa487a76f", "url": "https://sourceforge.net/p/bandizip/", "private": false, "short_description": "Bandizip is a fast and efficient file compression and archiving tool designed for Windows users, providing an intuitive interface and a wide array of compression formats. It supports popular archive formats like ZIP, RAR, 7Z, and more, allowing users to create, extract, and manage compressed files with ease. Bandizip is renowned for its high-speed processing and multi-core compression, making it a go-to option for handling large files or batches of files efficiently. It also includes encryption features to secure sensitive files and advanced settings for controlling the compression ratio. With its lightweight design and broad compatibility, Bandizip is an excellent choice for both casual users and professionals seeking a reliable and versatile compression tool.", "creation_date": "2024-09-20", "summary": "Fast & efficient file compression and archiving tool", "external_homepage": "https://bandizip.sourceforge.io", "video_url": null, "socialnetworks": [{"accounturl": null, "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "", "preferred_support_url": "", "developers": [{"username": "dappervoid", "name": "dv25", "url": "https://sourceforge.net/u/dappervoid/"}], "tools": [{"name": "activity", "mount_point": "activity", "url": "https://sourceforge.net/p/bandizip/activity/", "mount_label": "Activity", "api_url": "https://sourceforge.net/rest/p/bandizip/activity/"}, {"name": "summary", "mount_point": "summary", "url": "https://sourceforge.net/p/bandizip/summary/", "mount_label": "Summary", "sourceforge_group_id": 3799860}, {"name": "files-sf", "mount_point": "files-sf", "url": "https://sourceforge.net/p/bandizi
{"shortname": "socnetv", "name": "Social Network Visualizer", "_id": "50084b8afd48f86d030023e0", "url": "https://sourceforge.net/p/socnetv/", "private": false, "short_description": "Visit our new site: http://socnetv.org\r\n\r\nSocial Network Visualizer (SocNetV) is a social network analysis and visualization application. You can draw a social network (graph/digraph) or load an existing one (GraphML, UCINET, Pajek, etc), compute cohesion, centrality, community and structural equivalence metrics and apply various layout algorithms based on actor centrality or prestige scores (i.e. Eigenvector, Betweenness) or on dynamic models (i.e. Kamada-Kawai spring-embedder)", "creation_date": "2006-01-27", "summary": "Social Network Analysis and Visualization software", "external_homepage": "http://socnetv.org", "video_url": null, "socialnetworks": [{"accounturl": null, "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://socnetv.org/bugs/", "developers": [{"username": "miccagiann", "name": "Michael Yannakopoulos", "url": "https://sourceforge.net/u/miccagiann/"}, {"username": "oxy86", "name": "Dimitris Kalamaras", "url": "https://sourceforge.net/u/oxy86/"}], "tools": [{"name": "blog", "mount_point": "news", "url": "https://sourceforge.net/p/socnetv/news/", "mount_label": "News", "api_url": "https://sourceforge.net/rest/p/socnetv/news/"}, {"name": "files-sf", "mount_point": "files", "url": "https://sourceforge.net/p/socnetv/files/", "mount_label": "Files"}, {"name": "svn", "mount_point": "code", "url": "https://sourceforge.net/p/socnetv/code/", "mount_label": "Old Qt4 Code", "api_url": "https://sourceforge.net/rest/p/socnetv/code/", "clone_url_https_anon": "https://svn.code.sf.net/p/socnetv/code/trunk", "clone_url_ro": "svn://svn.code.sf.net/p/
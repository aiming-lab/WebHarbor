{"shortname": "swig", "name": "SWIG", "_id": "50d41c0fe88f3d22b56f5e70", "url": "https://sourceforge.net/p/swig/", "private": false, "short_description": "SWIG is a software development tool that connects programs written in C and C++ with a variety of high-level programming languages. SWIG is used with different types of target languages including common scripting languages such as Javascript, Perl, PHP, Python, Tcl and Ruby. The list of supported languages also includes non-scripting languages such as C#, D, Go language, Java, Lua, OCaml, Octave, R and Scilab as well as the Guile implementation of the Scheme language. SWIG is most commonly used to create high-level interpreted or compiled programming environments, user interfaces, and as a tool for testing and prototyping C/C++ software. SWIG is typically used to parse C/C++ interfaces and generate the 'glue code' required for the above target languages to call into the C/C++ code. SWIG can also export its parse tree in the form of XML. ", "creation_date": "2000-01-19", "summary": "A code generator for connecting C/C++ with other programming languages", "external_homepage": "http://www.swig.org", "video_url": null, "socialnetworks": [{"accounturl": null, "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "http://sourceforge.net/mailarchive/forum.php?forum_name=swig-user", "developers": [{"username": "arty", "name": "Art Yerkes", "url": "https://sourceforge.net/u/arty/"}, {"username": "yziquel", "name": "Guillaume Yziquel", "url": "https://sourceforge.net/u/yziquel/"}, {"username": "jgillis", "name": "jgillis", "url": "https://sourceforge.net/u/jgillis/"}, {"username": "smoratto", "name": "Stefano Moratto", "url": "https://sourceforge.net/u/smoratto/"}, {"username": "fukusima", "name": 
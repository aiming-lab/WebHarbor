{"shortname": "tilp", "name": "TILP - TI Linking Program", "_id": "51a798f35fcbc9453369e971", "url": "https://sourceforge.net/p/tilp/", "private": false, "short_description": "TILP (formerly GtkTiLink) can transfer data between Texas Instruments graphing calculators and a computer. It works with all link cables (parallel, serial, Black/Gray/Silver/Direct Link) and it supports the TI-Z80 series (73..86), the TI-eZ80 series (83PCE, 84+CE), the TI-68k series (89, 92, 92+, V200, 89T) and the Nspire series (Nspire Clickpad / Touchpad / CX, both CAS and non-CAS).\r\n\r\nThe project is now managed on Github, https://github.com/debrouxl/tilp_and_gfm . It uses the libti* libraries, https://github.com/debrouxl/tilibs .\r\nInstall script for *nix: https://github.com/debrouxl/tilp_and_gfm/blob/master/tilp/trunk/build/scripts/install_tilp.sh", "creation_date": "2001-01-15", "summary": "TI graphing calculators <-> computer communication software", "external_homepage": "https://github.com/debrouxl/tilp_and_gfm", "video_url": null, "socialnetworks": [{"accounturl": "", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://github.com/debrouxl/tilp_and_gfm/issues", "developers": [{"username": "floppusmaximus", "name": "Benjamin Moody", "url": "https://sourceforge.net/u/floppusmaximus/"}, {"username": "debrouxl", "name": "Lionel Debroux", "url": "https://sourceforge.net/u/debrouxl/"}, {"username": "roms", "name": "Romain Li\u00e9vin", "url": "https://sourceforge.net/u/roms/"}], "tools": [{"name": "tickets", "mount_point": "support-requests", "url": "https://sourceforge.net/p/tilp/support-requests/", "mount_label": "Support Requests", "api_url": "https://sourceforge.net/rest/p/tilp/support-requests/"}, {"name": "tickets", "mount_point": "bugs", "url": "https://sourceforge.net/p/tilp/bugs/", "mount_label": "Bugs", "api_url": "https://sourceforge.net/rest
{"shortname": "dolibarr", "name": "Dolibarr ERP - CRM", "_id": "5051177971b75b3040ddbca0", "url": "https://sourceforge.net/p/dolibarr/", "private": false, "short_description": "Dolibarr ERP - CRM is an easy to use ERP and CRM open source software package (run with a web php server or as standalone software) for businesses, foundations or freelancers (prospect, invoicing, inventory, warehouse, order, shipment, POS, members for foundations, bank accounts...).\r\n\r\nDolibarr is also available with auto-installers for users with no technical knowledge to install Dolibarr and all its prerequisites (Apache, Mysql, PHP) with just one package. Available platforms for such packages are: Windows, Debian, Ubuntu, Mint, Redhat, Fedora, OpenSuse, Mandriva, Mageia. Other platform can use the generic distribution.\r\n\r\nThis is a modular product, than can be enhanced with tons of external modules (to provide you features not available by default) from https://www.dolistore.com\r\n\r\nDownload Dolibarr ERP - CRM here or sign up for 15-day free trial of the cloud-based application with free updates and support at one of the Cloud providers https://saas.dolibarr.org/\r\n", "creation_date": "2005-11-28", "summary": "Open source ERP and CRM web software for business", "external_homepage": "https://www.dolibarr.org", "video_url": "www.youtube.com/embed/GJ8-r9bHyB8?rel=0", "socialnetworks": [{"accounturl": "https://www.twitter.com/dolibarr", "socialnetwork": "Twitter"}, {"accounturl": "https://www.facebook.com/dolibarr", "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://www.dolibarr.org/forums.php", "developers": [{"username": "simnandez", "name": "Juan  Jos\u00e9", "url": "https://sourceforge.net/u/simnandez/"}, {"username": "grandoc", "name": "Philippe GRAND", "url": "https://sourceforge.net/u/
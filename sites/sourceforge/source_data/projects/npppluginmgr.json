{"shortname": "npppluginmgr", "name": "Notepad++ Plugin Manager", "_id": "4ed4c35e0594ca048e000710", "url": "https://sourceforge.net/p/npppluginmgr/", "private": false, "short_description": "The nppPluginManager repository contains the legacy Plugin Manager for Notepad++, a tool that once allowed users to easily install, update, and remove plugins within the editor. It relied on a centrally hosted XML file that listed available plugins, which the manager compared against those already installed. Since 2019, however, the plugin is no longer actively maintained, and the supporting web service that provided plugin lists has been discontinued. Users are now encouraged to rely on Notepad++\u2019s built-in plugin solution instead of this deprecated tool.\r\n\r\nThis project is the old location for the plugin list for Notepad++ Plugin Manager.  \r\n\r\nPlease use https://github.com/bruderstein/npppluginmanager for any issues and current code", "creation_date": "2011-11-29", "summary": "Notepad++ Plugin Manager ", "external_homepage": null, "video_url": null, "socialnetworks": [{"accounturl": null, "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://github.com/bruderstein/npppluginmanager/issues", "developers": [{"username": "davegb3", "name": "Dave Brotherstone", "url": "https://sourceforge.net/u/davegb3/"}], "tools": [{"name": "git", "mount_point": "code", "url": "https://sourceforge.net/p/npppluginmgr/code/", "mount_label": "Code", "api_url": "https://sourceforge.net/rest/p/npppluginmgr/code/", "clone_url_https_anon": "https://git.code.sf.net/p/npppluginmgr/code", "clone_url_ro": "git://git.code.sf.net/p/npppluginmgr/code"}, {"name": "files-sf", "mount_point": "files", "url": "https://sourceforge.net/p/npppluginmgr/files/", "mount_lab
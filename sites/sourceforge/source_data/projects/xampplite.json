{"shortname": "xampplite", "name": "XAMPP-Lite", "_id": "6383ab9d7dfc165379c47081", "url": "https://sourceforge.net/p/xampplite/", "private": false, "short_description": "XAMPP-Lite is a lightweight WAMP server for web development (portable & installer, 32-bit & 64-bit). It includes Apache, PHP, MySQL/MariaDB, phpMyAdmin, Adminer, HeidiSQL, and more.\r\n\r\nLatest versions: PHP 8.5.5 - MariaDB 11.4.10 LTS - Apache 2.4.66 - phpMyAdmin 5.2.3 - Adminer 5.4.2 - HeidiSQL 12.16 - XDebug 3.5.1 - OpenSSL 3.6.2 - Pie 1.4.0, Composer 2.9.5 - Pear/Pecl 1.10.18.\r\n\r\nSystem requirements:\r\n\u2500 XAMPP-Lite 8.2 and below: Windows 7 and later (32-bit & 64-bit)\r\n\u2500 XAMPP-Lite 8.5 & 8.4 & 8.3:\r\n\u2800\u2800\u2500 32-bit: Windows 8 and later (32-bit & 64-bit)\r\n\u2800\u2800\u2500 64-bit: Windows 10 version 1703 and later (64-bit)", "creation_date": "2022-11-27", "summary": "Portable/Installer WAMP server including Apache, MariaDB/MySQL, PHP...", "external_homepage": "https://xampplite.sf.net", "video_url": null, "socialnetworks": [{"accounturl": null, "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_members", "preferred_support_url": "", "developers": [{"username": "moez-romdhane", "name": "Moez Romdhane", "url": "https://sourceforge.net/u/moez-romdhane/"}], "tools": [{"name": "activity", "mount_point": "activity", "url": "https://sourceforge.net/p/xampplite/activity/", "mount_label": "Activity", "api_url": "https://sourceforge.net/rest/p/xampplite/activity/"}, {"name": "summary", "mount_point": "summary", "url": "https://sourceforge.net/p/xampplite/summary/", "mount_label": "Summary", "sourceforge_group_id": 3578859}, {"name": "files-sf", "mount_point": "files-sf", "url": "https://sourceforge.net/p/xampplite/files-sf/", "mount_label": "Files"}, {"name": "reviews", "mou
{"shortname": "davmail", "name": "DavMail POP/IMAP/SMTP/Caldav to Exchange", "_id": "51b889e85fcbc96fa85a1f96", "url": "https://sourceforge.net/p/davmail/", "private": false, "short_description": "DavMail is a POP/IMAP/SMTP/CalDAV/CardDAV/LDAP Exchange and Office 365 gateway allowing users to use any mail/calendar client (e.g. Thunderbird with Lightning or Apple iCal) with an Exchange server. DavMail now includes an LDAP gateway to Exchange global address book and user personal contacts to allow recipient address completion in the mail compose window and full calendar support with attendee free busy display. The main goal of DavMail is to provide standard compliant protocols in front of proprietary Exchange. This means LDAP for address book search, SMTP to send messages, IMAP to browse messages on the server in any folder, POP to retrieve inbox messages only, CalDAV for calendar support and CardDAV for contact synchronization.", "creation_date": "2006-12-12", "summary": "", "external_homepage": "https://davmail.sourceforge.net", "video_url": null, "socialnetworks": [{"accounturl": null, "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://github.com/mguessan/davmail/issues", "developers": [{"username": "mguessan", "name": "Mickael Guessant", "url": "https://sourceforge.net/u/mguessan/"}], "tools": [{"name": "summary", "mount_point": "summary", "url": "https://sourceforge.net/p/davmail/summary/", "mount_label": "Summary", "sourceforge_group_id": 184600}, {"name": "reviews", "mount_point": "reviews", "url": "https://sourceforge.net/p/davmail/reviews/", "mount_label": "Reviews"}, {"name": "support", "mount_point": "support", "url": "https://sourceforge.net/p/davmail/support/", "mount_label": "Support"}, {"name": "tickets", "mount_poi
{"shortname": "naval-sem", "name": "NAVAL-SEM", "_id": "6a10557ab389b23fa9d0c098", "url": "https://sourceforge.net/p/naval-sem/", "private": false, "short_description": "NAVAL-SEM is an award-winning, free and open-source offline Structural Equation Modeling (SEM) platform supporting PLS-SEM and CB-SEM workflows. Designed for researchers, PhD scholars, professors, and analysts, it provides visual model building, measurement assessment, structural model analysis, and reproducible research workflows without subscriptions or cloud dependency.\r\n\r\nFeatures include:\r\n\u2022 PLS-SEM & CB-SEM\r\n\u2022 Bootstrapping, mediation, moderation & conditional process analysis\r\n\u2022 HTMT, AVE, Composite Reliability, Cronbach's Alpha, Fornell-Larcker\r\n\u2022 VIF, f\u00b2 effect size, indirect effects, Q\u00b2 blindfolding, PLSpredict, CVPAT\r\n\u2022 Multi-Group Analysis (MGA), HOC, MICOM\r\n\u2022 IPMA, NCA, nonlinear effects, FIMIX-PLS, PLS-POS, endogeneity checks\r\n\u2022 EFA, CVI, measurement validation, fsQCA\r\n\u2022 APA report generation and R/Python/Lavaan export\r\n\r\nFully offline and available for Windows, macOS, and Linux. Recognized with the SourceForge Rising Star Award.", "creation_date": "2026-05-22", "summary": "Award-winning open-source offline SEM platform for PLS-SEM & CB-SEM", "external_homepage": "https://naval-sem.sourceforge.io", "video_url": "www.youtube.com/embed/o4ePadTLbCE?rel=0", "socialnetworks": [{"accounturl": "https://x.com/naval_singh9", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_members", "preferred_support_url": "", "developers": [{"username": "navalsingh9", "name": "Naval Singh", "url": "https://sourceforge.net/u/navalsingh9/"}], "tools": [{"name": "activity", "mount_point": "activity", "url": "https://sourceforge.net/p/naval
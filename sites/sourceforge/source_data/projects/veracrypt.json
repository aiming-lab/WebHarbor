{"shortname": "veracrypt", "name": "VeraCrypt", "_id": "51c5a73c0910d40b9861739d", "url": "https://sourceforge.net/p/veracrypt/", "private": false, "short_description": "VeraCrypt is a free disk encryption software brought to you by IDRIX (https://www.idrix.fr) and based on TrueCrypt 7.1a.\r\n\r\nIt adds enhanced security to the algorithms used for system and partitions encryption making it immune to new developments in brute-force attacks. It also solves many vulnerabilities and security issues found in TrueCrypt. \r\n\r\nThis enhanced security adds some delay ONLY to the opening of encrypted partitions without any performance impact to the application use phase. This is acceptable to the legitimate owner but it makes it much harder for an attacker to gain access to the encrypted data.\r\n\r\nAll released files are PGP signed with key ID=0x680D16DE, available on key servers and downloadable at https://www.idrix.fr/VeraCrypt/VeraCrypt_PGP_public_key.asc\r\n\r\nVeraCrypt can mount TrueCrypt volumes. It also can convert them to VeraCrypt format.\r\n\r\nDocumentation: https://www.veracrypt.fr/en/Documentation.html\r\nFAQ : https://www.veracrypt.fr/en/FAQ.html\r\n", "creation_date": "2013-06-22", "summary": "Open source disk encryption with strong security for the Paranoid", "external_homepage": "https://www.veracrypt.fr", "video_url": null, "socialnetworks": [{"accounturl": "VeraCrypt_IDRIX", "socialnetwork": "Twitter"}, {"accounturl": "https://www.facebook.com/veracrypt", "socialnetwork": "Facebook"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "discussion", "preferred_support_url": "", "developers": [{"username": "idrassi", "name": "Mounir IDRASSI", "url": "https://sourceforge.net/u/idrassi/"}], "tools": [{"name": "files-sf", "mount_point": "files", "url": "https://sourceforge.net/p/veracrypt/files/", "mount_label": "Files"}, {"name": "discussion", "mount_point": "discussion", "url": "https://sourceforge.net/p/veracrypt/discussion/", "mount_lab
{"shortname": "mcpower", "name": "MCPower", "_id": "69921c77f21ee3c7f7b65520", "url": "https://sourceforge.net/p/mcpower/", "private": false, "short_description": "MCPower-GUI is a desktop application that provides a graphical interface for the MCPower Monte Carlo power analysis library. It guides users through the full workflow across three tabs: Model setup (formula input with live parsing, CSV data upload with auto-detected variable types, effect size sliders, and correlation editing), Analysis configuration (find power for a given sample size or find the minimum sample size for a target power,  with multiple testing correction and scenario analysis), and Results (interactive charts, exportable tables, and auto-generated Python replication scripts). Supports both standard linear models and mixed-effects models. Additional features include analysis history, configurable scenarios, and built-in documentation.", "creation_date": "2026-02-15", "summary": "MCPower \u2014 simple Monte Carlo power analysis for complex models", "external_homepage": "https://mcpower.sourceforge.io", "video_url": null, "socialnetworks": [{"accounturl": "https://x.com/freestyler_sci", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://pawlenartowicz.pl/support_me/", "developers": [{"username": "pawlenartowicz", "name": "Pawe\u0142 Lenartowicz", "url": "https://sourceforge.net/u/pawlenartowicz/"}], "tools": [{"name": "activity", "mount_point": "activity", "url": "https://sourceforge.net/p/mcpower/activity/", "mount_label": "Activity", "api_url": "https://sourceforge.net/rest/p/mcpower/activity/"}, {"name": "summary", "mount_point": "summary", "url": "https://sourceforge.net/p/mcpower/summary/", "mount_label": "Summary", "sourceforge_group_id": 3959021}, 
{"shortname": "ventoy", "name": "Ventoy", "_id": "651473369e2fb7788e34d04c", "url": "https://sourceforge.net/p/ventoy/", "private": false, "short_description": "Ventoy is an open source tool to create bootable USB drive for ISO/WIM/IMG/VHD(x)/EFI files.\r\n\r\nWith Ventoy, you don't need to format the disk over and over, you just need to copy the ISO/WIM/IMG/VHD(x)/EFI files to the USB drive and boot them directly.\r\n\r\nYou can copy many files at a time and Ventoy will give you a boot menu to select them.\r\n\r\nYou can also browse ISO/WIM/IMG/VHD(x)/EFI files in local disks and boot them.\r\n\r\nx86 Legacy BIOS, IA32 UEFI, x86_64 UEFI, ARM64 UEFI and MIPS64EL UEFI are supported in the same way.\r\n\r\nMost types of OS supported (Windows/WinPE/Linux/ChromeOS/Unix/VMware/Xen...)\r\n\r\n1100+ ISO files are tested, 90%+ distros in distrowatch.com supported.", "creation_date": "2023-09-27", "summary": "A New Bootable USB Solution", "external_homepage": "https://www.ventoy.net/", "video_url": null, "socialnetworks": [{"accounturl": "https://twitter.com/ventoy6", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}, {"accounturl": null, "socialnetwork": "Fediverse"}, {"accounturl": null, "socialnetwork": "Instagram"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://forums.ventoy.net/", "developers": [{"username": "longpanda", "name": "longpanda", "url": "https://sourceforge.net/u/longpanda/"}], "tools": [{"name": "activity", "mount_point": "activity", "url": "https://sourceforge.net/p/ventoy/activity/", "mount_label": "Activity", "api_url": "https://sourceforge.net/rest/p/ventoy/activity/"}, {"name": "summary", "mount_point": "summary", "url": "https://sourceforge.net/p/ventoy/summary/", "mount_label": "Summary", "sourceforge_group_id": 3679283}, {"name": "files-sf", "mount_point": "files-sf", "url": "https://sourceforge.net/p/ventoy/files-sf/", "mount_label": "Files"}, {"name": "revi
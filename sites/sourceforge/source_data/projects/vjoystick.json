{"shortname": "vjoystick", "name": "vJoy", "_id": "5006ec3371b75b2a6300071a", "url": "https://sourceforge.net/p/vjoystick/", "private": false, "short_description": "This project was originally designed to provide an open-source replacement for PPJoy. The product, at this point, consists of virtual joystick devices that is seen by the system as a standard joystick but its position-data is written to it by a feeder application. An existing feeder application that takes advantage of this product is SmartPropoPlus. If you are an application writer you can very easily write an application that controls a joystick (e.g. mouse-to-joystick, keyboard-to-joystick). If you are a beginner in device drivers you can take this code and enhance it to support more (or less) axes, buttons or POVs.\r\n", "creation_date": "2010-10-27", "summary": "", "external_homepage": "http://vjoystick.sourceforge.net/joomla/", "video_url": null, "socialnetworks": [{"accounturl": "", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "http://vjoystick.sourceforge.net/joomla/index.php/forum/index/2-support", "developers": [{"username": "shaul_ei", "name": "Shaul", "url": "https://sourceforge.net/u/shaul_ei/"}], "tools": [{"name": "svn", "mount_point": "code", "url": "https://sourceforge.net/p/vjoystick/code/", "mount_label": "Code (Old)", "api_url": "https://sourceforge.net/rest/p/vjoystick/code/", "clone_url_https_anon": "https://svn.code.sf.net/p/vjoystick/code/trunk", "clone_url_ro": "svn://svn.code.sf.net/p/vjoystick/code/trunk"}, {"name": "files-sf", "mount_point": "files", "url": "https://sourceforge.net/p/vjoystick/files/", "mount_label": "Files"}, {"name": "summary", "mount_point": "summary", "url": "https://sourceforge.net/p/vjoystick/summary/", "mount_label": "Summary", "sourceforge_group_id": 366796}, {"name": "reviews", "mount_point": "reviews", "url": "https://
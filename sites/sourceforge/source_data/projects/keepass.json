{"shortname": "keepass", "name": "KeePass", "_id": "50aa543ee88f3d1588a55130", "url": "https://sourceforge.net/p/keepass/", "private": false, "short_description": "KeePass Password Safe is a free, open source, lightweight, and easy-to-use password manager for Windows, Linux and Mac OS X, with ports for Android, iPhone/iPad and other mobile devices. With so many passwords to remember and the need to vary passwords to protect your valuable data, it\u2019s nice to have KeePass to manage your passwords in a secure way. KeePass puts all your passwords in a highly encrypted database and locks them with one master key or a key file. As a result, you only have to remember one single master password or select the key file to unlock the whole database. And the databases are encrypted using the best and most secure encryption algorithms currently known, AES and Twofish. See our features page for details.", "creation_date": "2003-11-15", "summary": "A lightweight and easy-to-use password manager", "external_homepage": "https://keepass.info/", "video_url": null, "socialnetworks": [{"accounturl": "", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "https://sourceforge.net/p/keepass/discussion/329221/", "developers": [{"username": "artpoli", "name": "artpoli", "url": "https://sourceforge.net/u/artpoli/"}, {"username": "kostelecno", "name": "Pavel Rzeh\u00e1k", "url": "https://sourceforge.net/u/kostelecno/"}, {"username": "eyebex", "name": "Sebastian Schuberth", "url": "https://sourceforge.net/u/eyebex/"}, {"username": "tomers", "name": "Tomer Shalev", "url": "https://sourceforge.net/u/tomers/"}, {"username": "kkoenders", "name": "Kees Koenders", "url": "https://sourceforge.net/u/kkoenders/"}, {"username": "vbmauro", "name": "Mauro Rossi", "url": "https://sourceforge.net/u/vbmauro/"}, {"username": "ivek85", "name": "ivek", "url": "https://sourceforge.n
{"shortname": "vlc", "name": "VLC media player", "_id": "50452feabfc09e48583e5d62", "url": "https://sourceforge.net/p/vlc/", "private": false, "short_description": "VLC is an open source cross-platform multimedia player and framework, which plays most multimedia files, DVDs, Audio CDs, VCDs, and various streaming protocols. VLC media player is simple, fast, and powerful. It plays everything, files, discs, webcams, devices, and streams. VLC plays most codecs (MPEG-2, DivX, H.264, MKV, WebM, WMV, MP3, etc.) so no codec packs are needed. It runs on all platforms: Windows, Linux, Mac OS X, Unix, etc. And VLC is hassle free with no spyware, no ads, and no user tracking.", "creation_date": "2010-04-29", "summary": "The best free media player for video and DVDs", "external_homepage": "http://www.videolan.org/vlc/", "video_url": "www.youtube.com/embed/N3fOEd0oWb8?rel=0", "socialnetworks": [{"accounturl": "", "socialnetwork": "Twitter"}, {"accounturl": null, "socialnetwork": "Facebook"}], "status": "active", "moved_to_url": "", "preferred_support_tool": "_url", "preferred_support_url": "http://www.videolan.org/support/", "developers": [{"username": "thresh_alt", "name": "thresh", "url": "https://sourceforge.net/u/thresh_alt/"}, {"username": "kempfjb", "name": "Jean-Baptiste Kempf", "url": "https://sourceforge.net/u/kempfjb/"}, {"username": "fkuehne", "name": "Felix Paul K\u00fchne", "url": "https://sourceforge.net/u/fkuehne/"}], "tools": [{"name": "summary", "mount_point": "summary", "url": "https://sourceforge.net/p/vlc/summary/", "mount_label": "Summary", "sourceforge_group_id": 319696}, {"name": "files-sf", "mount_point": "files", "url": "https://sourceforge.net/p/vlc/files/", "mount_label": "Files"}, {"name": "support", "mount_point": "support", "url": "https://sourceforge.net/p/vlc/support/", "mount_label": "Support"}, {"name": "reviews", "mount_point": "reviews", "url": "https://sourceforge.net/p/vlc/reviews/", "mount_label": "Reviews"}, {"name": "activity", "mount_poi
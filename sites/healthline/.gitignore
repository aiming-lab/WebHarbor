# Build-time scrape intermediate — never shipped (runtime data lives in
# instance_seed/healthline.db). The repository root .gitignore already ignores
# `sites/*/scraped_data/` (rule verified with `git check-ignore -v`); this local
# rule is a belt-and-braces duplicate kept so a standalone copy of the site
# directory still excludes the harvested HTML and images.
scraped_data/

# Recreated from instance_seed/ on every boot; not committed.
instance/
__pycache__/
*.pyc
